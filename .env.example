# =============================================================================
# Planillas CCDR Liberia - variables de entorno (plantilla)
# Copie este archivo a .env y ajuste los valores. NUNCA suba .env al repositorio.
# Fuente: internal/config/config.go (LoadConfig). Los valores comentados con
# "defecto" coinciden con los que el código aplica si la variable no existe.
# Las marcadas [REQUERIDA] hacen fallar el arranque si faltan.
# =============================================================================

# ----------------------------------------------------------------------------
# APP
# ----------------------------------------------------------------------------
# Entorno de ejecución: development | staging | production (defecto: development).
APP_ENV=development
# Nivel de log: debug | info | warn | error (defecto: debug). Los logs salen en JSON
# (log/slog) por stdout, con request_id; nunca incluyen cuerpos, tokens ni query strings.
LOG_LEVEL=debug

# ----------------------------------------------------------------------------
# SERVER
# ----------------------------------------------------------------------------
# Puerto HTTP de escucha, sin ":" (defecto: 8080).
SERVER_PORT=8080
# Tiempo máximo para leer una petición, en segundos (defecto: 10).
SERVER_READ_TIMEOUT_SECONDS=10
# Tiempo máximo para escribir una respuesta, en segundos (defecto: 15).
SERVER_WRITE_TIMEOUT_SECONDS=15
# Tiempo máximo de conexión inactiva (keep-alive), en segundos (defecto: 60).
SERVER_IDLE_TIMEOUT_SECONDS=60
# Tiempo máximo de apagado ordenado, en segundos (defecto: 15).
SERVER_SHUTDOWN_TIMEOUT_SECONDS=15

# Tamaño máximo del cuerpo de una petición, en bytes (defecto: 1048576 = 1 MiB). Más -> 413.
MAX_BODY_BYTES=1048576
# IP/CIDR (separadas por coma) de los proxies/balanceadores propios que pueden informar la
# IP real del cliente por X-Forwarded-For. VACÍO = no se confía en ninguno (se usa la IP del
# socket). Nunca 0.0.0.0/0 ni ::/0 (prohibido en producción): permitiría evadir el rate limit.
# Ej.: 10.0.0.0/8,192.168.1.10
TRUSTED_PROXIES=
# Orígenes CORS permitidos (lista blanca exacta, separada por coma, sin barra final). VACÍO =
# ninguno. "*" no se admite. En producción deben ser https://. Ej.: https://planillas.ccdrliberia.go.cr
CORS_ALLOWED_ORIGINS=

# ----------------------------------------------------------------------------
# RATE LIMITING (F16 / S8) - [REQUERIDAS], sin valor por defecto, deben ser > 0
# ----------------------------------------------------------------------------
# Límite en memoria POR PROCESO (con varias réplicas el límite efectivo se multiplica; ver
# docs/ADR-001). Los valores de abajo son un punto de partida razonable, no un defecto del código.
# Login, refresh, logout y reset de contraseña: por IP y por ruta. Peticiones sostenidas/min y ráfaga.
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_AUTH_BURST=10
# Resto de la API: por usuario autenticado.
RATE_LIMIT_USER_PER_MIN=300
RATE_LIMIT_USER_BURST=60

# ----------------------------------------------------------------------------
# DATABASE (MySQL)
# ----------------------------------------------------------------------------
# Host del servidor MySQL (defecto: 127.0.0.1).
DB_HOST=127.0.0.1
# Puerto de MySQL (defecto: 3306).
DB_PORT=3306
# [REQUERIDA] Usuario de la base de datos; en producción use uno con mínimo privilegio.
DB_USER=planillas_app
# Contraseña del usuario; [REQUERIDA] cuando APP_ENV=production.
DB_PASSWORD=cambiar_esta_clave
# [REQUERIDA] Nombre de la base de datos.
DB_NAME=planillas_ccdr
# Parámetros extra del DSN del driver, formato clave=valor unidos por & (defecto: el del ejemplo).
DB_PARAMS=parseTime=true&loc=UTC&charset=utf8mb4
# Máximo de conexiones abiertas del pool (defecto: 25).
DB_MAX_OPEN_CONNS=25
# Máximo de conexiones inactivas del pool (defecto: 25).
DB_MAX_IDLE_CONNS=25
# Vida máxima de una conexión, en minutos (defecto: 5).
DB_CONN_MAX_LIFETIME_MINUTES=5
# Tiempo máximo que una conexión puede estar inactiva, en minutos (defecto: 2).
DB_CONN_MAX_IDLE_TIME_MINUTES=2
# Tiempo máximo para establecer la conexión, en segundos (defecto: 5).
DB_CONNECT_TIMEOUT_SECONDS=5
# Tiempo máximo del ping de verificación al arrancar, en segundos (defecto: 5).
DB_PING_TIMEOUT_SECONDS=5

# TLS hacia MySQL (F16 / S9): disabled | required | verify-full (defecto: disabled).
#   disabled    sin TLS. El arranque FALLA con APP_ENV=production.
#   required    TLS obligatorio pero SIN verificar el certificado (cifra, no autentica al servidor).
#   verify-full TLS verificando cadena y nombre (DB_HOST debe figurar en el certificado). Recomendado.
DB_TLS_MODE=disabled
# CA (PEM) con la que verificar el servidor; solo con verify-full (vacío = raíces del sistema).
# No ponga tls= en DB_PARAMS: el TLS se controla únicamente con DB_TLS_MODE.
DB_TLS_CA_FILE=

# ----------------------------------------------------------------------------
# AUTH / PASETO
# ----------------------------------------------------------------------------
# [REQUERIDA, F15] Llavero PASETO v4.local: "kid:hex,kid:hex"; cada clave son 32 bytes
# aleatorios en hex (64 caracteres). kid = letras, dígitos, _ o - (máx. 32).
# El valor de abajo es un PLACEHOLDER INVÁLIDO a propósito (el arranque fallará hasta que lo reemplace).
# Generar cada clave con:  openssl rand -hex 32
# Rotación: 1) agregar la clave nueva ("k2:...") junto a la vieja y desplegar; 2) cambiar
# PASETO_ACTIVE_KID=k2; 3) tras la vigencia del refresh token (7 días), retirar "k1".
PASETO_LOCAL_KEYS_HEX=k1:REEMPLAZAR_CON_64_CARACTERES_HEX_GENERADOS_CON_OPENSSL_RAND_HEX_32
# Kid con el que se firman los tokens nuevos. Obligatorio si hay más de una clave.
PASETO_ACTIVE_KID=k1
# (LEGADO) Una sola clave, equivale a kid "k1". Se ignora si PASETO_LOCAL_KEYS_HEX está definida.
# PASETO_LOCAL_KEY_HEX=
# Caché del verificador de sesión (duración Go: 5s, 0 = sin caché; máx. 1m). Es la latencia
# MÁXIMA con la que una desactivación o revocación de rol corta un access token (defecto: 5s).
AUTH_CACHE_TTL=5s
# Vigencia del access token, en minutos; debe ser > 0 (defecto: 20).
PASETO_ACCESS_TOKEN_MINUTES=20
# Emisor (iss) que se firma y se EXIGE en los tokens (defecto: planillas-ccdr).
PASETO_ISSUER=planillas-ccdr
# Audiencia (aud) que se firma y se EXIGE en los tokens (defecto: planillas-ccdr-api).
PASETO_AUDIENCE=planillas-ccdr-api
# Vigencia del refresh token, en horas; debe ser mayor que la del access token (defecto: 168 = 7 días).
AUTH_REFRESH_TOKEN_HOURS=168
# Vigencia del token de reseteo de contraseña (un solo uso), en minutos; > 0 (defecto: 30).
AUTH_PASSWORD_RESET_TOKEN_MINUTES=30
# Intentos de login fallidos consecutivos antes de bloquear la cuenta; > 0 (defecto: 5).
AUTH_MAX_FAILED_LOGINS=5
# Duración del bloqueo de cuenta tras superar el máximo de intentos, en minutos; > 0 (defecto: 15).
AUTH_LOCKOUT_MINUTES=15

# ----------------------------------------------------------------------------
# PARÁMETROS GENERALES (F18A)
# ----------------------------------------------------------------------------
# Caché en memoria de parametros_generales (duración Go: 30s, 0 = sin caché; máx. 5m).
# Es la latencia MÁXIMA con la que un cambio de parámetro se ve en un proceso que no
# invalidó su caché (defecto: 30s).
PARAMETROS_CACHE_TTL=30s

# ----------------------------------------------------------------------------
# SMTP / RESET DE CONTRASEÑA POR CORREO (F14)
# ----------------------------------------------------------------------------
# Host del servidor SMTP. [REQUERIDA] con APP_ENV=production y en staging.
# Vacío SOLO se acepta con APP_ENV=development: ahí el token de reset se
# escribe en el log de la aplicación (LogNotificador) en vez de enviarse.
SMTP_HOST=
# Puerto SMTP (defecto: 587). 465 = TLS implícito; cualquier otro puerto exige STARTTLS.
SMTP_PORT=587
# Usuario y clave de autenticación SMTP (dejar vacío si el relay no autentica).
SMTP_USER=
SMTP_PASS=
# Remitente. [REQUERIDA] si hay SMTP_HOST. Ej.: Planillas CCDR <no-responder@ccdrliberia.go.cr>
SMTP_FROM=
# URL del frontend a la que se agrega ?token=... en el correo. [REQUERIDA] si hay
# SMTP_HOST; en producción debe empezar con https://.
URL_BASE_RESET=